{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhhos98-cell/frontispieces_18chistoriography/schema/record.schema.json",
  "title": "Frontispiece Historiography Corpus Record",
  "type": "object",
  "required": ["id", "record_type", "label", "evidence_status", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "record_type": {
      "enum": ["plate_series", "witness_cluster", "witness", "copy", "agent", "feature", "source_evidence", "relationship", "bibliographic_lead"]
    },
    "label": {"type": "string", "minLength": 1},
    "date": {"type": ["string", "null"]},
    "date_note": {"type": ["string", "null"]},
    "place": {"type": ["string", "null"]},
    "publication": {
      "type": ["object", "null"],
      "properties": {
        "title": {"type": ["string", "null"]},
        "format": {"type": ["string", "null"]},
        "imprint_literal": {"type": ["string", "null"]},
        "signature": {"type": ["string", "null"]},
        "institution": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name_literal", "role"],
        "properties": {
          "authority_id": {"type": ["string", "null"]},
          "name_literal": {"type": "string"},
          "role": {"type": "string"},
          "identity_status": {"enum": ["resolved", "provisional", "unresolved"]}
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {"type": "string"},
          "value": {"type": "string"},
          "normalised": {"type": ["string", "null"]}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predicate", "target"],
        "properties": {
          "predicate": {
            "enum": ["same_plate_as", "variant_of", "derived_from", "probable_relation", "appears_in", "designed_by", "engraved_by", "issued_by", "printed_by", "published_by", "successor_to", "predecessor_to", "reported_in", "evidenced_by"]
          },
          "target": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low", "unassessed"]},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_status": {
      "enum": ["verified_primary", "verified_catalogue", "reported_correspondence", "research_inference", "unresolved"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_type"],
        "properties": {
          "source_id": {"type": "string"},
          "source_type": {"type": "string"},
          "citation": {"type": ["string", "null"]},
          "access": {"enum": ["public", "private_mailbox", "local_file", "institutional_catalogue", "unknown"]},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "notes": {"type": ["string", "null"]},
    "todo": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}